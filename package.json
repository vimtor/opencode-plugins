{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "OpenCode plugins maintained by vimtor.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "tsc --noEmit && bun run --filter './packages/*' typecheck",
    "test": "bun test",
    "test:packages": "bun scripts/test-packages.mjs",
    "smoke": "bun run --filter './packages/*' smoke",
    "pack:dry-run": "bun run --filter './packages/*' pack:dry-run",
    "prepublishOnly": "bun run --filter './packages/*' prepublishOnly",
    "version": "changeset version && bun install --lockfile-only",
    "release": "changeset publish"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "ai"
  ],
  "author": "vimtor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimtor/opencode-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/vimtor/opencode-plugins/issues"
  },
  "homepage": "https://github.com/vimtor/opencode-plugins#readme",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@opencode/plugin": "0.0.0-beta-19296",
    "@opentui/core": "0.5.10",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
