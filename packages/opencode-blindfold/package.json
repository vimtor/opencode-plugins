{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-blindfold",
  "version": "0.5.0",
  "description": "OpenCode plugin that lets agents use secrets the user provides without seeing their values.",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "smoke": "bun -e \"Promise.all([import('./dist/server.js'), import('./dist/tui.js')]).then((modules) => { for (const m of modules) if (!m.default?.id || typeof m.default.setup !== 'function') throw new Error('missing V2 plugin export') })\" && bun --conditions=import -e \"if (typeof require('./dist/gui-experimental.cjs').default?.setup !== 'function') throw new Error('missing GUI plugin export')\"",
    "pack:dry-run": "bun pm pack --dry-run",
    "prepack": "bun run build && bun run smoke",
    "prepublishOnly": "bun run prepack && bun run typecheck"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "opencode-desktop",
    "plugin",
    "secrets",
    "redaction",
    "security",
    "ai"
  ],
  "author": "vimtor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimtor/opencode-plugins.git",
    "directory": "packages/opencode-blindfold"
  },
  "bugs": {
    "url": "https://github.com/vimtor/opencode-plugins/issues"
  },
  "homepage": "https://github.com/vimtor/opencode-plugins/tree/main/packages/opencode-blindfold#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
