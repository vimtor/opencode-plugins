{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-quick-links",
  "version": "1.2.1",
  "description": "OpenCode plugin for searching and opening links from the active conversation.",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "tui.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun --conditions=browser test",
    "smoke": "bun -e \"import('./dist/tui.js').then((m) => { if (!m.default?.id || typeof m.default.setup !== 'function') throw new Error('missing V2 CLI plugin export') })\" && bun --conditions=import -e \"if (typeof require('./dist/gui-experimental.cjs').default?.setup !== 'function') throw new Error('missing GUI plugin export')\"",
    "pack:dry-run": "bun pm pack --dry-run",
    "prepack": "bun run build && bun run smoke",
    "prepublishOnly": "bun run prepack && bun run typecheck"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "opencode-desktop",
    "plugin",
    "links",
    "browser",
    "ai"
  ],
  "author": "vimtor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vimtor/opencode-plugins.git",
    "directory": "packages/opencode-quick-links"
  },
  "bugs": {
    "url": "https://github.com/vimtor/opencode-plugins/issues"
  },
  "homepage": "https://github.com/vimtor/opencode-plugins/tree/main/packages/opencode-quick-links#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "open": "^10.1.2"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
